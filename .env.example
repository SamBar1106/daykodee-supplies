# Public Wix Headless OAuth client ID for the supplies portal.
# This is a public client ID, not a secret API key. A dedicated supplies
# OAuth client is still to be created (see KANBAN.md SUP-002).
# Until then, leave this blank or fill it only in a local unscommitted .env.
#
# Preview / local redirect URI to allow on that client:
#   http://localhost:5173/callback
# Production redirect URI (after go-live, not yet enabled):
#   https://supplies.daykodee.com/callback
#
# Do not put client secrets, API keys, tokens, or personal data here.
VITE_WIX_CLIENT_ID=
